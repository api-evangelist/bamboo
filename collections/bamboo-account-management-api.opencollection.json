                "value": "en"
              },
              {
                "name": "x-user-id",
                "value": ""
              },
              {
                "name": "x-subject-type",
                "value": ""
              },
              {
                "name": "x-client-token",
                "value": ""
              }
            ]
          },
          "docs": "Access detailed investment profile information and brokerage account details.\n"
        }
      ]
