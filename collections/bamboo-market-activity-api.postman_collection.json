                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"extended_hours_status\": \"<boolean>\",\n  \"market\": \"<string>\"\n}",
